# Numen server (server.py). Copy to .env.
#
# Agents, knowledge bases and phone numbers are managed in the web app (web/) and stored
# in PostgreSQL. The provider keys below can also be set in the web app (Settings);
# values saved there override these.

DATABASE_URL=postgresql+psycopg://localhost/numen
PORT=7860

# Users sign in with their own accounts (created in the web app; the first visit sets up
# the first admin). Email for password resets and invites is set in Settings > Email.

# Provider keys (or set them in the web app under Settings)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Where Twilio reaches this server, e.g. your ngrok URL (or set it in Settings)
PUBLIC_BASE_URL=

# Optional: where per-call JSON + debug logs are written (default ./logs)
# LOG_DIR=

# ---- First-run import only ---------------------------------------------------------
# On an empty database these turn the original CLA bot into an agent, a knowledge base
# and a phone number. After that, edit everything in the web app.
TWILIO_PHONE_NUMBER=
KB_SERVICE_URL=
KB_API_KEY=
TRANSFER_NUMBER=
AFTER_HOURS_TRANSFER_NUMBER=
